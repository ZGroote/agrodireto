# Copie para .env e preencha. Nunca coloque estas chaves em um app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que o Supabase envia no cabeçalho Authorization: Bearer <WORKER_TOKEN> ao avisar uma mídia nova
WORKER_TOKEN=

# Opcionais (valores padrão abaixo)
PORT=8080
CODEC_VIDEO=hevc
VMAF_MINIMO=95
WEBP_QUALIDADE=90
PSNR_MINIMO_DB=38
CONCORRENCIA=1
APAGAR_ORIGINAL_APOS_OTIMIZAR=true
