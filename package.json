{
  "name": "agrodireto",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "hub": "node scripts/hub.mjs",
    "lint": "eslint apps packages services",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "node scripts/export-web.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build:web"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
